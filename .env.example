# ---------------------------------------------------------------------------
# Copy this file to .env.local. Environment files are gitignored.
#
# The public site works without Supabase. The contact form and private admin
# inbox require a Supabase project and the schema in supabase/migrations.
# If Supabase is not configured, the form gives visitors the public GitHub
# contact route instead of showing an upstream developer's email address.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API.
# The anon key is a public identifier. Row-level security controls access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional Google Search Console verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION= 