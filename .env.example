# Optional canonical production URL (no trailing slash).
# Netlify's URL value is used as a fallback when this is omitted.
NEXT_PUBLIC_SITE_URL=

# Optional public contact address. If blank, the site links to GitHub.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional Supabase project values for contact submissions and /admin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Google Search Console verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
